{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "assets": [
      {
        "exclude": "public/{battle-backgrounds,card-characters,playable-cards}/**",
        "include": "public/**/*",
        "outDir": "dist",
        "restartOnChange": false
      }
    ],
    "builder": "swc",
    "deleteOutDir": true,
    "watchAssets": true
  },
  "sourceRoot": "src"
}
