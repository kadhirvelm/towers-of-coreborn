generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  output          = "../dist"
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x", "darwin-arm64", "debian-openssl-3.0.x"]
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String
  filePath    String
}

/// Encrypted ProductNow OAuth session for one browser. The payload is AES-GCM
/// ciphertext; access and refresh tokens are never stored in plaintext.
model ProductNowOAuthSession {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connected Boolean  @default(false)
  payload   String
}
