{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_LINKER"],
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_HOST_URL",
        "BACKEND_API_URL",
        "FRONTEND_URL",
        "GEMINI_CREDENTIALS",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "ci": {
      "dependsOn": ["build", "check", "lint", "test"]
    },
    "db:migrate": {
      "env": ["DATABASE_HOST_URL"]
    },
    "dev": {
      "env": [
        "DATABASE_HOST_URL",
        "BACKEND_API_URL",
        "FRONTEND_URL",
        "GEMINI_CREDENTIALS",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
